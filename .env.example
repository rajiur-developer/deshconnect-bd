# --- Site ---
NEXT_PUBLIC_SITE_URL=https://deshconnect.vercel.app
NEXT_PUBLIC_APP_URL=https://deshconnect.vercel.app

# --- Auth ---
# Signs the local session cookie. Required outside development: at least 32
# characters. Generate with: openssl rand -base64 48
AUTH_SECRET=

# --- InsForge ---
# No trailing slash: the client appends "/api/..." to this base URL.
NEXT_PUBLIC_INSFORGE_URL=https://qk8ksk3i.us-east.insforge.app
# Public anon key. Get it with: npx -y @insforge/cli secrets get ANON_KEY
NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_4a348f47f687395a65d7e8f8c394727e6696ef89d615c39a99357e8c21e6eced

# --- Optional self-hosted LibreTranslate ---
# Bengali locale translates visible UI and user-submitted text through this service.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# --- Google Maps (optional; pages fall back to an external map link) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
